# 飞书企业自建应用的 App ID。开放平台 → 凭证与基础信息。
FEISHU_APP_ID=

# 飞书应用密钥。不要发到聊天或群里。
FEISHU_APP_SECRET=

# 达人管理业务表。只写播放量、授权状态、每行更新时间。可填整段链接，或地址栏 /sheets/ 后面那一段。
FEISHU_SPREADSHEET_TOKEN=

# 新建的 TikView 系统表。放「授权」和自动更新时间。可填整段链接，或 /sheets/ 后面那一段。
FEISHU_TIKVIEW_SPREADSHEET_TOKEN=

# 达人管理文件里有多张业务工作表时才填名称。一般留空。
# FEISHU_SHEET_TITLE=

# 达人管理文件里有多张业务工作表时才填工作表 ID（URL 里 sheet= 后面）。一般留空。
# FEISHU_SHEET_ID=

# TikTok Login Kit 的 Client Key。审核通过前用沙箱（sb 开头），通过后换成正式环境。
TIKTOK_CLIENT_KEY=

# TikTok Login Kit 的 Client Secret。要和上面的 Client Key 同一套环境。
TIKTOK_CLIENT_SECRET=

# 作者点完授权后回到这个地址。必须和 TikTok 后台 Redirect URI、Cloudflare Worker 上的值一致。
TIKTOK_REDIRECT_URI=

# 给授权链接盖章用。本地 .env 和 Worker 里必须填同一个值，不要发给别人。
STATE_SECRET=

# 飞书群会话 ID，播放量更新结果和授权异常会发到这个群。形如 oc_。
FEISHU_CHAT_ID=
